<template>
  <div class="page">
    <div class="home" if="{{ !settingsOpen }}">
      <text class="demo-label" if="{{ demo }}" style="font-size: {{ auxiliarySize }}px; font-family: {{ fontFamily }};">演示 · 非真实导航</text>
      <div class="navigation-stage" if="{{ guidance }}" style="top: {{ contentTop }}px; height: {{ contentHeight }}px;">
        <image class="arrow" src="{{ arrowSrc }}" style="left: {{ arrowLeft }}px; width: {{ arrowDrawSize }}px; height: {{ arrowDrawSize }}px;"></image>
        <text class="exit-number" if="{{ roundaboutExit }}" style="left: {{ exitNumberLeft }}px; top: {{ exitNumberTop }}px; width: {{ exitNumberWidth }}px; height: {{ exitNumberHeight }}px; line-height: {{ exitNumberHeight }}px; font-size: {{ exitNumberFontSize }}px; color: {{ arrowColorValue }};">{{ roundaboutExit }}</text>
        <list class="guidance-list" style="top: {{ guidanceTop }}px; height: {{ guidanceHeight }}px;">
          <list-item for="{{ guidanceLines }}" type="guidance" class="guidance-row" style="height: {{ rowHeight }}px;">
            <text class="guidance-text" style="height: {{ rowHeight }}px; line-height: {{ rowHeight }}px; font-size: {{ fontSize }}px; font-family: {{ guidanceFontFamily }}; color: {{ textColorValue }};">{{ $item }}</text>
          </list-item>
        </list>
      </div>
      <div class="rest" if="{{ !guidance }}" style="top: {{ restTop }}px; height: {{ restHeight }}px;">
        <div class="rest-titles" style="height: {{ restTitleHeight }}px;">
          <text for="{{ titleLines }}" class="rest-title" style="height: {{ titleHeight }}px; line-height: {{ titleHeight }}px; font-size: {{ fontSize }}px; font-family: {{ fontFamily }}; color: {{ textColorValue }};">{{ $item }}</text>
        </div>
        <div class="rest-hints" style="top: {{ hintTop }}px; height: {{ hintsHeight }}px;">
          <text for="{{ hintLines }}" class="rest-hint" style="height: {{ hintHeight }}px; line-height: {{ hintHeight }}px; font-size: {{ hintSize }}px; font-family: {{ fontFamily }};">{{ $item }}</text>
        </div>
        <list class="details" if="{{ hasDetails }}" style="top: {{ detailsTop }}px; height: {{ detailsHeight }}px;">
          <list-item for="{{ rawLines }}" type="detail" class="detail-row" style="height: {{ hintHeight }}px;">
            <text class="raw" style="height: {{ hintHeight }}px; line-height: {{ hintHeight }}px; font-size: {{ hintSize }}px; font-family: {{ detailsFontFamily }};">{{ $item }}</text>
          </list-item>
        </list>
      </div>
      <div class="settings-entry" onclick="openSettings" style="left: {{ gearLeft }}px; top: {{ gearTop }}px;">
        <image class="settings-icon" src="/common/settings.png"></image>
      </div>
    </div>
    <div class="settings" if="{{ settingsOpen }}">
      <text class="back" onclick="settingsBack">‹</text>
      <text class="settings-title" style="font-size: {{ fontSize }}px; height: {{ titleHeight }}px; line-height: {{ titleHeight }}px; font-family: {{ fontFamily }};">{{ settingsTitle }}</text>
      <list class="settings-list" if="{{ !pickerOpen }}" style="top: {{ settingsListTop }}px; height: {{ settingsListHeight }}px;">
        <list-item type="font" class="picker-row" style="height: {{ pickerRowHeight }}px;">
          <div class="picker-selector" onclick="openPicker('font')" style="height: {{ pickerHeight }}px;">
            <text class="picker-label" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ hintSize }}px; font-family: {{ fontFamily }};">字体</text>
            <text class="picker-value" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ labelSize }}px; font-family: {{ fontFamily }};">{{ fontName }}</text>
            <text class="picker-chevron" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px;">›</text>
          </div>
        </list-item>
        <list-item type="font-size" class="setting-block font-size-row" style="height: {{ settingRowHeight }}px;">
          <text class="setting-label" style="font-size: {{ labelSize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px; font-family: {{ fontFamily }};">文字大小</text>
          <div class="stepper" style="top: {{ controlTop }}px; height: {{ buttonHeight }}px;">
            <text class="adjust decrease" onclick="adjust('fontSize', -1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">−</text>
            <text class="setting-value" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ fontSize }}px; font-family: {{ fontFamily }};">{{ fontSize }}</text>
            <text class="adjust increase" onclick="adjust('fontSize', 1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">+</text>
          </div>
        </list-item>
        <list-item type="text-color" class="picker-row" style="height: {{ pickerRowHeight }}px;">
          <div class="picker-selector" onclick="openPicker('textColor')" style="height: {{ pickerHeight }}px;">
            <text class="picker-label" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ hintSize }}px; font-family: {{ fontFamily }};">文字颜色</text>
            <text class="picker-value" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ labelSize }}px; font-family: {{ fontFamily }}; color: {{ textColorValue }};">{{ textColorName }}</text>
            <text class="picker-chevron" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px;">›</text>
          </div>
        </list-item>
        <list-item type="arrow-style" class="picker-row" style="height: {{ pickerRowHeight }}px;">
          <div class="picker-selector" onclick="openPicker('arrowStyle')" style="height: {{ pickerHeight }}px;">
            <text class="picker-label" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ hintSize }}px; font-family: {{ fontFamily }};">箭头样式</text>
            <text class="picker-value" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ labelSize }}px; font-family: {{ fontFamily }};">{{ arrowStyleName }}</text>
            <text class="picker-chevron" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px;">›</text>
          </div>
        </list-item>
        <list-item type="arrow-size" class="setting-block arrow-size-row" style="height: {{ settingRowHeight }}px;">
          <text class="setting-label" style="font-size: {{ labelSize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px; font-family: {{ fontFamily }};">箭头大小</text>
          <div class="stepper" style="top: {{ controlTop }}px; height: {{ buttonHeight }}px;">
            <text class="adjust decrease" onclick="adjust('arrowSize', -2)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">−</text>
            <text class="setting-value" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ fontSize }}px; font-family: {{ fontFamily }};">{{ arrowSize }}</text>
            <text class="adjust increase" onclick="adjust('arrowSize', 2)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">+</text>
          </div>
        </list-item>
        <list-item type="arrow-weight" class="setting-block arrow-weight-row" style="height: {{ settingRowHeight }}px;">
          <text class="setting-label" style="font-size: {{ labelSize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px; font-family: {{ fontFamily }};">箭头粗细</text>
          <div class="stepper" style="top: {{ controlTop }}px; height: {{ buttonHeight }}px;">
            <text class="adjust decrease" onclick="adjust('arrowWeight', -1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">−</text>
            <text class="setting-value" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ fontSize }}px; font-family: {{ fontFamily }};">{{ arrowWeight }}</text>
            <text class="adjust increase" onclick="adjust('arrowWeight', 1)" style="height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-size: {{ adjustSize }}px;">+</text>
          </div>
        </list-item>
        <list-item type="arrow-color" class="picker-row" style="height: {{ pickerRowHeight }}px;">
          <div class="picker-selector" onclick="openPicker('arrowColor')" style="height: {{ pickerHeight }}px;">
            <text class="picker-label" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ hintSize }}px; font-family: {{ fontFamily }};">箭头颜色</text>
            <text class="picker-value" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ labelSize }}px; font-family: {{ fontFamily }}; color: {{ arrowColorValue }};">{{ arrowColorName }}</text>
            <text class="picker-chevron" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px;">›</text>
          </div>
        </list-item>
        <list-item type="haptic-enabled" class="picker-row haptic-toggle-row" style="height: {{ pickerRowHeight }}px;">
          <div class="picker-selector haptic-toggle" onclick="toggleHaptic" style="height: {{ pickerHeight }}px;">
            <text class="picker-label" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ hintSize }}px; font-family: {{ fontFamily }};">振动提醒</text>
            <text class="picker-value" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ labelSize }}px; color: {{ hapticEnabled ? '#80f5be' : '#b7c9bd' }};">{{ hapticEnabled ? '开启' : '关闭' }}</text>
          </div>
        </list-item>
        <list-item type="haptic" class="picker-row haptic-row" style="height: {{ pickerRowHeight }}px;">
          <div class="picker-selector" onclick="openPicker('haptic')" style="height: {{ pickerHeight }}px;">
            <text class="picker-label" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ hintSize }}px; font-family: {{ fontFamily }};">提醒震感</text>
            <text class="picker-value" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px; font-size: {{ labelSize }}px; font-family: {{ fontFamily }};">{{ hapticName }}</text>
            <text class="picker-chevron" style="height: {{ pickerHeight }}px; line-height: {{ pickerHeight }}px;">›</text>
          </div>
        </list-item>
        <list-item type="haptic-test" class="reset-row" style="height: {{ buttonHeight + 16 }}px;">
          <text class="settings-button haptic-test" onclick="testHaptic" style="font-size: {{ labelSize }}px; height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-family: {{ fontFamily }};">试振两下</text>
        </list-item>
        <list-item type="haptic-status" class="link-row" style="height: {{ auxiliaryHeight + 10 }}px;">
          <text class="link-state" style="font-size: {{ auxiliarySize }}px; height: {{ auxiliaryHeight }}px; line-height: {{ auxiliaryHeight }}px;">{{ hapticStatus }}</text>
        </list-item>
        <list-item type="footer" class="settings-footer" style="height: {{ footerHeight }}px;">
          <text class="save-status" style="font-size: {{ auxiliarySize }}px; height: {{ auxiliaryHeight }}px; line-height: {{ auxiliaryHeight }}px; font-family: {{ fontFamily }};">{{ saveStatus }}</text>
          <text class="version" style="top: {{ auxiliaryHeight + 4 }}px; font-size: {{ auxiliarySize }}px; height: {{ auxiliaryHeight }}px; line-height: {{ auxiliaryHeight }}px; font-family: {{ fontFamily }};">腕上导航 v{{ versionName }}</text>
        </list-item>
        <list-item type="link" class="link-row" style="height: {{ auxiliaryHeight + 10 }}px;">
          <text class="link-state" style="font-size: {{ auxiliarySize }}px; height: {{ auxiliaryHeight }}px; line-height: {{ auxiliaryHeight }}px; font-family: {{ fontFamily }};">{{ linkText }}</text>
        </list-item>
        <list-item type="reset" class="reset-row" style="height: {{ buttonHeight + 16 }}px;">
          <text class="settings-button reset-defaults" onclick="resetSettings" style="font-size: {{ labelSize }}px; height: {{ buttonHeight }}px; line-height: {{ buttonHeight }}px; font-family: {{ fontFamily }};">恢复默认</text>
        </list-item>
      </list>
      <list class="option-list" if="{{ pickerOpen }}" style="top: {{ settingsListTop }}px; height: {{ settingsListHeight }}px;">
        <list-item for="{{ pickerOptions }}" type="option" class="option-row" style="height: {{ optionRowHeight }}px;">
          <div class="option-card" onclick="selectOption($item.id)" style="height: {{ optionHeight }}px; background-color: {{ $item.selected ? '#253b2c' : '#101a14' }};">
            <text class="option-name" style="font-size: {{ labelSize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px; font-family: {{ fontFamily }};">{{ $item.name }}</text>
            <text class="option-selected" if="{{ $item.selected }}" style="font-size: {{ auxiliarySize }}px; height: {{ labelHeight }}px; line-height: {{ labelHeight }}px;">已选</text>
            <text class="option-sample" if="{{ $item.showSample }}" style="top: {{ labelHeight + 8 }}px; font-family: {{ $item.family }}; font-size: {{ fontSize }}px; color: {{ $item.color }}; height: {{ titleHeight }}px; line-height: {{ titleHeight }}px;">{{ $item.sample }}</text>
            <image class="option-arrow" if="{{ $item.showImage }}" src="{{ $item.image }}" style="top: {{ labelHeight + 4 }}px; width: {{ optionArrowSize }}px; height: {{ optionArrowSize }}px;"></image>
          </div>
        </list-item>
      </list>
    </div>
  </div>
</template>

<script>
const protocol = require('../../common/protocol')
const sessions = require('../../common/session')
const nativeApi = require('../../common/native')
const haptics = require('../../common/haptics')
const presentation = require('../../common/presentation')
const settings = require('../../common/settings')
const geometry = require('../../common/geometry')
const manifest = require('../../manifest.json')
let preferenceStore = null
let session = null
let unsubscribe = null
let latest = null
let receivedAt = 0
let connected = false
let timer = null
let connectionError = ''
let alive = false
let visible = false
let screenRequested = false
let screenRevision = 0
let screenError = ''
// 0 = bare string payload (older firmware), 1 = documented { data: { data } } envelope.
let sendShape = 0
let lastSend = '尚未发送'
// CONNECTED / DISCONNECTED / UNINSTALLED, as reported by the interconnect service.
let apkStatus = '未检测'


export default {
  private: {
    settingsOpen: false,
    pickerOpen: false,
    pickerKind: '',
    settingsTitle: '导航设置',
    hapticProfile: haptics.DEFAULT,
    hapticEnabled: true,
    hapticName: '明显',
    hapticStatus: '调整后自动保存',
    pickerOptions: [],
    pickerValue: '',
    font: settings.DEFAULTS.font,
    fontSize: settings.DEFAULTS.fontSize,
    arrowSize: settings.DEFAULTS.arrowSize,
    arrowDrawSize: settings.DEFAULTS.arrowSize,
    arrowWeight: settings.DEFAULTS.arrowWeight,
    textColor: settings.DEFAULTS.textColor,
    textColorName: '白色',
    textColorValue: '#ffffff',
    arrowColor: settings.DEFAULTS.arrowColor,
    arrowColorName: '白色',
    arrowColorValue: '#ffffff',
    arrowStyle: settings.DEFAULTS.arrowStyle,
    arrowStyleName: '线条',
    fontFamily: 'sans-serif',
    guidanceFontFamily: 'sans-serif',
    detailsFontFamily: 'sans-serif',
    fontName: '系统默认',
    labelSize: 24, hintSize: 22, auxiliarySize: 18,
    titleHeight: 42, labelHeight: 28, hintHeight: 31, auxiliaryHeight: 23,
    buttonHeight: 52, controlTop: 32, settingRowHeight: 96,
    pickerHeight: 44, pickerRowHeight: 56, footerHeight: 50,
    adjustSize: 35, optionHeight: 86, optionRowHeight: 98, optionArrowSize: 42,
    settingsListTop: geometry.SETTINGS_TOP, settingsListHeight: geometry.settingsListHeight(42),
    gearLeft: geometry.GEAR_LEFT, gearTop: geometry.GEAR_TOP,
    titleLines: [], restTitleHeight: 42, hintTop: 54, hintsHeight: 62,
    saveStatus: '调整后自动保存',
    linkText: '互联未连接 · 尚未发送 · 手机端 未检测',
    versionName: manifest.versionName,
    guidanceLines: [' '],
    guidanceHeight: 48,
    rowHeight: 48,
    contentTop: 167,
    contentHeight: 146,
    arrowLeft: 105,
    guidanceTop: 98,
    hintLines: [],
    hasDetails: false,
    detailsTop: 0,
    detailsHeight: 0,
    restTop: 184,
    restHeight: 112,
    demo: false,
    arrowSrc: '/common/arrows/line/white/8/unknown.png',
    roundaboutExit: '',
    exitNumberLeft: 124,
    exitNumberTop: 22.5,
    exitNumberWidth: 40,
    exitNumberHeight: 40,
    exitNumberFontSize: 30,
    status: '等待导航',
    icon: '/common/unknown.png',
    distance: '',
    instruction: '',
    rawLines: [' '],
    header: '腕上导航',
    guidance: false,
    statusColor: '#64776b',
    distanceValue: '',
    distanceUnit: '',
    distanceSize: 72,
    hint: '在手机上连接小米运动健康'
  },
  onInit() {
    if (preferenceStore) preferenceStore.dispose()
    preferenceStore = null
    this.settingsOpen = false
    this.closePicker()
    this.applySettings(settings.DEFAULTS)
    visible = false
    screenRequested = false
    screenError = ''
    alive = true
    if (unsubscribe) unsubscribe()
    const app = this.$app && this.$app.$def
    session = app && app.navigationSession || sessions.getSession(nativeApi.loadNative, () => Date.now(),
      (fn, delay) => setTimeout(fn, delay), id => clearTimeout(id))
    this.syncSession(session.peek())
    unsubscribe = session.subscribe(state => this.syncSession(state))
    this.paint()
  },
  // App owns the transport; onReady also supports standalone browser previews.
  onReady() {
    this.loadSettings()
    this.retry()
  },
  loadSettings() {
    if (!alive || preferenceStore) return
    try {
      preferenceStore = settings.createStore(require('@system.storage'),
        value => { if (alive) { this.applySettings(value); this.paint() } },
        value => { if (alive) this.saveStatus = value })
      preferenceStore.load()
    } catch (error) { this.saveStatus = '本次调整无法保存' }
  },
  applySettings(value) {
    const checked = settings.normalize(value)
    this.font = checked.font
    this.fontName = settings.fontOption(checked.font).short
    this.fontFamily = settings.fontOption(checked.font).family
    const text = settings.colorOption(checked.textColor)
    this.textColor = checked.textColor
    this.textColorName = text.short
    this.textColorValue = text.value
    const arrow = settings.colorOption(checked.arrowColor)
    this.arrowColor = checked.arrowColor
    this.arrowColorName = arrow.short
    this.arrowColorValue = arrow.value
    this.arrowStyle = checked.arrowStyle
    this.arrowStyleName = settings.styleOption(checked.arrowStyle).name
    const type = presentation.typography(checked.fontSize)
    for (const field of Object.keys(type)) this[field] = type[field]
    this.settingsListTop = geometry.settingsListTop(type.titleHeight)
    this.settingsListHeight = geometry.settingsListHeight(type.titleHeight)
    this.pickerHeight = type.fontSelectorHeight
    this.pickerRowHeight = type.fontRowHeight
    this.optionHeight = type.fontChoiceHeight
    this.optionRowHeight = type.fontChoiceHeight + 12
    this.optionArrowSize = type.titleHeight
    this.fontSize = checked.fontSize
    this.arrowSize = checked.arrowSize
    this.arrowWeight = checked.arrowWeight
  },
  adjust(field, change) {
    if (!alive || !settings.LIMITS[field]) return
    const value = this.currentSettings()
    value[field] += Number(change)
    const checked = settings.normalize(value)
    if (this[field] === checked[field]) return
    this.saveSettings(checked)
  },
  currentSettings() {
    return { font: this.font, fontSize: this.fontSize, arrowSize: this.arrowSize, arrowWeight: this.arrowWeight,
      textColor: this.textColor, arrowColor: this.arrowColor, arrowStyle: this.arrowStyle }
  },
  saveSettings(value) {
    if (!alive) return
    const checked = settings.normalize(value)
    this.applySettings(checked)
    this.paint()
    if (preferenceStore) preferenceStore.save(checked)
    else this.saveStatus = '本次调整无法保存'
  },
  resetSettings() {
    this.saveSettings(settings.DEFAULTS)
    if (alive && session) session.selectHaptic(haptics.DEFAULT)
    if (alive && session) session.setHapticEnabled(true)
  },
  toggleHaptic() { if (alive && session) session.setHapticEnabled(!this.hapticEnabled) },
  testHaptic() {
    if (!alive || !visible || !this.settingsOpen) return
    if (!this.hapticEnabled) { this.hapticStatus = '请先开启振动提醒'; return }
    this.hapticStatus = session.testHaptic() ? '已请求试振两下' : '正在提醒或振动不可用'
  },
  // One exclusive list serves every choice; the options carry their own preview.
  openPicker(kind) {
    if (!alive) return
    const options = kind === 'haptic' ? haptics.OPTIONS : settings.optionsFor(kind)
    if (!options.length) return
    const value = kind === 'haptic' ? this.hapticProfile : this.currentSettings()[kind]
    this.pickerKind = kind
    this.settingsTitle = kind === 'haptic' ? '提醒震感' : settings.PICKER_TITLES[kind]
    this.pickerValue = value
    this.pickerOptions = options.map(item => {
      const option = { id: item.id, name: item.name, family: this.fontFamily, sample: '', color: '#ffffff',
        image: '', showSample: false, showImage: false, selected: item.id === value }
      if (kind === 'haptic') {
        option.sample = item.sample
        option.showSample = true
      } else if (kind === 'font') {
        option.family = item.family
        option.sample = '直行200米'
        option.showSample = true
      } else if (kind === 'textColor') {
        option.color = item.value
        option.sample = '直行200米'
        option.showSample = true
      } else if (kind === 'arrowColor') {
        option.image = settings.arrowPath(this.arrowStyle, item.id, this.arrowWeight, 'straight')
        option.showImage = true
      } else if (kind === 'arrowStyle') {
        option.image = settings.arrowPath(item.id, this.arrowColor, this.arrowWeight, 'straight')
        option.showImage = true
      }
      return option
    })
    this.pickerOpen = true
  },
  selectOption(id) {
    if (!alive || !this.pickerOpen) return
    const options = this.pickerKind === 'haptic' ? haptics.OPTIONS : settings.optionsFor(this.pickerKind)
    let found = null
    for (const option of options) if (option.id === id) found = option
    if (!found) return
    if (this.pickerKind === 'haptic') {
      session.selectHaptic(id)
      this.closePicker()
      return
    }
    const value = this.currentSettings()
    value[this.pickerKind] = id
    this.closePicker()
    this.saveSettings(value)
  },
  closePicker() {
    this.pickerOpen = false
    this.pickerKind = ''
    this.settingsTitle = '导航设置'
    this.pickerOptions = []
  },
  openSettings() { this.settingsOpen = true; this.closePicker(); this.paint() },
  closeSettings() { session.cancelHapticTest(); this.closePicker(); this.settingsOpen = false; this.paint() },
  settingsBack() {
    if (this.pickerOpen) this.closePicker()
    else this.closeSettings()
  },
  onBackPress() {
    if (this.settingsOpen) { this.settingsBack(); return true }
    return false
  },
  onShow() {
    visible = true
    this.syncSession(session.peek())
    if (session.peek().hasConnection) this.retry()
  },
  onHide() {
    if (session) session.cancelHapticTest()
    visible = false
    if (timer) clearTimeout(timer)
    timer = null
    this.keepScreenOn(false)
  },
  onDestroy() {
    if (session) session.cancelHapticTest()
    if (preferenceStore) preferenceStore.dispose()
    preferenceStore = null
    alive = false
    visible = false
    // Release again if the previous off request failed or is still pending.
    this.keepScreenOn(false, true)
    if (timer) clearTimeout(timer)
    timer = null
    if (unsubscribe) unsubscribe()
    unsubscribe = null
    latest = null
  },
  syncSession(state) {
    if (!alive) return
    this.hapticProfile = state.haptic.profile
    this.hapticEnabled = state.haptic.enabled
    this.hapticName = haptics.profile(state.haptic.profile).name
    this.hapticStatus = state.haptic.status
    latest = state.latest
    receivedAt = state.receivedAt
    connected = state.connected
    connectionError = state.connectionError
    sendShape = state.sendShape
    lastSend = state.lastSend
    apkStatus = state.apkStatus
    if (visible) this.paint()
  },
  retry() {
    if (!alive || !session) return
    session.retry()
    this.syncSession(session.peek())
    this.paint()
  },
  scheduleExpiry() {
    if (timer) clearTimeout(timer)
    timer = null
    if (!alive || !visible || !connected || !latest) return
    if (latest.status !== 'active' && latest.status !== 'demo') return
    const remaining = protocol.EXPIRY_MS - (Date.now() - receivedAt)
    if (remaining > 0) timer = setTimeout(() => { timer = null; this.paint() }, remaining)
  },
  keepScreenOn(value, force) {
    if (!force && screenRequested === value) return
    screenRequested = value
    screenError = ''
    const revision = ++screenRevision
    const fail = (data, code) => {
      if (!alive || revision !== screenRevision) return
      screenError = presentation.errorText(value ? '常亮开启失败' : '常亮关闭失败', data, code)
      this.paint()
    }
    try {
      // Load lazily: a missing brightness API must not stop navigation rendering.
      const brightness = require('@system.brightness')
      brightness.setKeepScreenOn({ keepScreenOn: value, fail })
    } catch (error) { fail(error) }
  },
  paint() {
    const now = Date.now()
    const age = now - receivedAt
    let view = protocol.present(latest, age, connected)
    this.keepScreenOn(visible && !this.settingsOpen && !!view.live && latest.keepScreenOn !== false)
    apkStatus = session ? session.peek().apkStatus : '未检测'
    if (connectionError) {
      view.status = '连接不可用'
      view.rawText = connectionError
    }
    // Nothing has ever arrived from the phone: name the missing link (attached,
    // app not running, app missing) instead of one generic waiting hint.
    if (!latest && !connectionError) {
      view.status = presentation.waitingStatus(connected, apkStatus)
      if (view.status === '等待导航') view.rawText = '手机端APK：' + apkStatus
    }
    this.scheduleExpiry()
    if (this.status !== view.status) this.status = view.status
    const icon = '/common/' + view.icon + '.png'
    if (this.icon !== icon) this.icon = icon
    if (this.distance !== view.distance) this.distance = view.distance
    if (this.instruction !== view.instruction) this.instruction = view.instruction
    const layout = presentation.layout(view)
    this.demo = view.status === '演示 · 非真实导航'
    this.arrowSrc = settings.arrowPath(this.arrowStyle, this.arrowColor, this.arrowWeight, view.icon)
    const navigation = presentation.navigationLayout(view, this, screenError)
    for (const field of ['arrowDrawSize', 'rowHeight', 'guidanceHeight', 'contentTop', 'contentHeight', 'arrowLeft', 'guidanceTop',
      'roundaboutExit', 'exitNumberLeft', 'exitNumberTop', 'exitNumberWidth', 'exitNumberHeight', 'exitNumberFontSize']) {
      if (this[field] !== navigation[field]) this[field] = navigation[field]
    }
    if (navigation.guidanceLines.join('\n') !== this.guidanceLines.join('\n')) this.guidanceLines = navigation.guidanceLines
    for (const field of ['header', 'guidance', 'statusColor', 'distanceValue', 'distanceUnit', 'distanceSize', 'hint']) {
      if (this[field] !== layout[field]) this[field] = layout[field]
    }
    this.linkText = (connected ? '互联已连接' : '互联未连接') + ' · ' + lastSend + ' · 手机端 ' + apkStatus
    this.guidanceFontFamily = settings.fontForText(this.font, navigation.guidanceLines.join(''))
    const rest = presentation.restLayout(view, screenError, this)
    this.detailsFontFamily = settings.fontForText(this.font, rest.rawLines.join(''))
    if (rest.titleLines.join('\n') !== this.titleLines.join('\n')) this.titleLines = rest.titleLines
    for (const field of ['restTitleHeight', 'hintTop', 'hintsHeight', 'hasDetails', 'detailsTop', 'detailsHeight', 'restTop', 'restHeight']) {
      if (this[field] !== rest[field]) this[field] = rest[field]
    }
    if (rest.hintLines.join('\n') !== this.hintLines.join('\n')) this.hintLines = rest.hintLines
    // Unchanged heartbeats renew expiry without rebuilding native views.
    if (rest.rawLines.join('\n') !== this.rawLines.join('\n')) this.rawLines = rest.rawLines
  }
}
</script>

