.stepper { position: absolute; left: 0px; width: 288px; height: 52px; }
.adjust { position: absolute; top: 0px; width: 44px; height: 52px; background-color: #1a281f; border-radius: 10px; color: #e8f2eb; text-align: center; }
.decrease { left: 44px; }
.increase { left: 200px; }
.setting-value { position: absolute; top: 0px; left: 100px; width: 88px; color: #ffffff; text-align: center; }
